# Root Monorepo Git Ignore

# Dependencies
node_modules/
frontend/node_modules/
backend/vendor/

# Build outputs
frontend/.next/
frontend/out/
frontend/build/
backend/public/build/
backend/public/hot

# Environment files
*.env
*.env.local
*.env.production
*.env.development
!backend/.env.example

# Logs and databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/storage/logs/*.log
backend/database/*.sqlite
backend/database/*.sqlite-journal

# Testing & Cache
.phpunit.result.cache
frontend/coverage/
.turbo/
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*

# OS and IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user

